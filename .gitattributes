# 统一行尾处理，避免跨平台踩坑

# 默认：仓库内统一存 LF
* text=auto eol=lf

# Shell 脚本必须 LF
# 若被转成 CRLF，在 macOS / Linux 上执行会报错 "\r: command not found"
*.sh text eol=lf
*.bash text eol=lf

# Windows 脚本用 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
